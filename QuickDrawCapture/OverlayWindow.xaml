<Window x:Class="QuickDrawCapture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="Black" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Left="0" Top="0" Width="800" Height="600">
    <Window.Resources>
        <ControlTemplate x:Key="IconBtn" TargetType="ButtonBase">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="IconToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="IconStyle" TargetType="ButtonBase">
            <Setter Property="Template" Value="{StaticResource IconBtn}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="Canvas">
            <Image x:Name="Shot" Stretch="Fill"/>
            <InkCanvas x:Name="Ink" Background="Transparent" UseCustomCursor="False"/>
        </Grid>

        <Border x:Name="Toolbar" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="40,40,0,0" Background="#EE202124" CornerRadius="8" Padding="6"
                MouseLeftButtonDown="Toolbar_Drag" Cursor="SizeAll">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="Colors" Orientation="Horizontal"/>
                <Rectangle Width="1" Fill="#666" Margin="6,2"/>
                <StackPanel x:Name="Sizes" Orientation="Horizontal"/>
                <Rectangle Width="1" Fill="#666" Margin="6,2"/>
                <ToggleButton x:Name="EraserBtn" Style="{StaticResource IconStyle}" Template="{StaticResource IconToggle}" Content="&#xE75C;" Click="Eraser_Click" ToolTip="Eraser"/>
                <Button Style="{StaticResource IconStyle}" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"/>
                <Button Style="{StaticResource IconStyle}" Content="&#xE73E;" Foreground="#16B96B" Click="Copy_Click" ToolTip="Copy and close (Esc)"/>
                <Button Style="{StaticResource IconStyle}" Content="&#xE711;" Foreground="#FF6060" Click="Cancel_Click" ToolTip="Close without copying"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
